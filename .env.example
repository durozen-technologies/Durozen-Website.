# ==========================================
# DUROZEN Portfolio - Environment Configuration
# ==========================================

# Frontend (Vite) Configuration
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000

# Backend Server Configuration
PORT=8000

# Database Configuration (Docker & Local)
DB_PORT=5432
POSTGRES_DB=durozen_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# PostgreSQL Connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/durozen_db

# Security & Admin Authentication
SECRET_KEY=durozen-creative-portfolio-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=durozenAdmin2026!

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Optional: Gemini API Key (if using AI Studio / Gemini features)
GEMINI_API_KEY=
