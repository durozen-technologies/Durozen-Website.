# PostgreSQL Connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Example for local PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/durozen_db

# Fallback: if local PostgreSQL is not currently running or configured,
# the backend can use SQLite for instant offline development if USE_SQLITE_FALLBACK=true
USE_SQLITE_FALLBACK=true

# Security & Admin Authentication
SECRET_KEY=durozen-creative-portfolio-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=durozenAdmin2026!

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

